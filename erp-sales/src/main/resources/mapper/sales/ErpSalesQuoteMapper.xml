<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.sales.mapper.ErpSalesQuoteMapper">

    <resultMap type="ErpSalesQuote" id="ErpSalesQuoteResult">
        <result property="quoteId"    column="quote_id"    />
        <result property="quoteCode"    column="quote_code"    />
        <result property="customerId"    column="customer_id"    />
        <result property="quoteDate"    column="quote_date"    />
        <result property="validDate"    column="valid_date"    />
        <result property="currency"    column="currency"    />
        <result property="amountTax"    column="amount_tax"    />
        <result property="amountNotax"    column="amount_notax"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpSalesQuoteErpSalesQuoteLineResult" type="ErpSalesQuote" extends="ErpSalesQuoteResult">
        <collection property="erpSalesQuoteLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpSalesQuoteLineResult" />
    </resultMap>

    <resultMap type="ErpSalesQuoteLine" id="ErpSalesQuoteLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="quoteId"    column="sub_quote_id"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="qty"    column="sub_qty"    />
        <result property="price"    column="sub_price"    />
        <result property="taxRate"    column="sub_tax_rate"    />
        <result property="amount"    column="sub_amount"    />
        <result property="deliveryDate"    column="sub_delivery_date"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpSalesQuoteVo">
        select quote_id, quote_code, customer_id, quote_date, valid_date, currency, amount_tax, amount_notax, status, create_by, create_time, update_by, update_time, remark from erp_sales_quote
    </sql>

    <select id="selectErpSalesQuoteList" parameterType="ErpSalesQuote" resultMap="ErpSalesQuoteResult">
        <include refid="selectErpSalesQuoteVo"/>
        <where>
            del_flag = '0'
            <if test="quoteCode != null  and quoteCode != ''"> and quote_code like concat('%', #{quoteCode}, '%')</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="quoteDate != null "> and quote_date = #{quoteDate}</if>
            <if test="validDate != null "> and valid_date = #{validDate}</if>
            <if test="currency != null  and currency != ''"> and currency = #{currency}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpSalesQuoteByQuoteId" parameterType="Long" resultMap="ErpSalesQuoteErpSalesQuoteLineResult">
        select a.quote_id, a.quote_code, a.customer_id, a.quote_date, a.valid_date, a.currency, a.amount_tax, a.amount_notax, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.quote_id as sub_quote_id, b.line_no as sub_line_no, b.material_id as sub_material_id, b.qty as sub_qty, b.price as sub_price, b.tax_rate as sub_tax_rate, b.amount as sub_amount, b.delivery_date as sub_delivery_date, b.create_time as sub_create_time
        from erp_sales_quote a
        left join erp_sales_quote_line b on b.quote_id = a.quote_id
        where a.quote_id = #{quoteId}
    </select>

    <insert id="insertErpSalesQuote" parameterType="ErpSalesQuote" useGeneratedKeys="true" keyProperty="quoteId">
        insert into erp_sales_quote
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">quote_code,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="quoteDate != null">quote_date,</if>
            <if test="validDate != null">valid_date,</if>
            <if test="currency != null">currency,</if>
            <if test="amountTax != null">amount_tax,</if>
            <if test="amountNotax != null">amount_notax,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">#{quoteCode},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="quoteDate != null">#{quoteDate},</if>
            <if test="validDate != null">#{validDate},</if>
            <if test="currency != null">#{currency},</if>
            <if test="amountTax != null">#{amountTax},</if>
            <if test="amountNotax != null">#{amountNotax},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpSalesQuote" parameterType="ErpSalesQuote">
        update erp_sales_quote
        <trim prefix="SET" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">quote_code = #{quoteCode},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="quoteDate != null">quote_date = #{quoteDate},</if>
            <if test="validDate != null">valid_date = #{validDate},</if>
            <if test="currency != null">currency = #{currency},</if>
            <if test="amountTax != null">amount_tax = #{amountTax},</if>
            <if test="amountNotax != null">amount_notax = #{amountNotax},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where quote_id = #{quoteId}
    </update>

    <delete id="deleteErpSalesQuoteByQuoteId" parameterType="Long">
        update erp_sales_quote set del_flag = '2' where quote_id = #{quoteId}
    </delete>

    <delete id="deleteErpSalesQuoteByQuoteIds" parameterType="String">
        update erp_sales_quote set del_flag = '2' where quote_id in
        <foreach item="quoteId" collection="array" open="(" separator="," close=")">
            #{quoteId}
        </foreach>
    </delete>

    <delete id="deleteErpSalesQuoteLineByQuoteId" parameterType="Long">
        delete from erp_sales_quote_line where quote_id = #{quoteId}
    </delete>

    <delete id="deleteErpSalesQuoteLineByQuoteIds" parameterType="String">
        delete from erp_sales_quote_line where quote_id in
        <foreach item="quoteId" collection="array" open="(" separator="," close=")">
            #{quoteId}
        </foreach>
    </delete>

    <insert id="batchErpSalesQuoteLine">
        insert into erp_sales_quote_line( line_id, quote_id, line_no, material_id, qty, price, tax_rate, amount, delivery_date, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.quoteId}, #{item.lineNo}, #{item.materialId}, #{item.qty}, #{item.price}, #{item.taxRate}, #{item.amount}, #{item.deliveryDate}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
