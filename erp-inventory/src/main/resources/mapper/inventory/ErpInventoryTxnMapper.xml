    <sql id="selectErpInventoryTxnVo">
        select txn_id, txn_type, material_id, warehouse_id, location_id, batch_no, direction, qty, cost_price, amount, source_type, source_id, source_code, oper_by, txn_time, create_time from erp_inventory_txn
    </sql>

    <select id="selectErpInventoryTxnList" parameterType="ErpInventoryTxn" resultMap="ErpInventoryTxnResult">
        <include refid="selectErpInventoryTxnVo"/>
        <where>
            <if test="txnType != null  and txnType != ''"> and txn_type = #{txnType}</if>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="locationId != null "> and location_id = #{locationId}</if>
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="direction != null  and direction != ''"> and direction = #{direction}</if>
            <if test="qty != null "> and qty = #{qty}</if>
            <if test="costPrice != null "> and cost_price = #{costPrice}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="sourceCode != null  and sourceCode != ''"> and source_code = #{sourceCode}</if>
            <if test="operBy != null  and operBy != ''"> and oper_by = #{operBy}</if>
            <if test="txnTime != null "> and txn_time = #{txnTime}</if>
        </where>
    </select>

    <select id="selectErpInventoryTxnByTxnId" parameterType="Long" resultMap="ErpInventoryTxnResult">
        <include refid="selectErpInventoryTxnVo"/>
        where txn_id = #{txnId}
    </select>

    <insert id="insertErpInventoryTxn" parameterType="ErpInventoryTxn" useGeneratedKeys="true" keyProperty="txnId">
        insert into erp_inventory_txn
        <trim prefix="(" suffix=")" suffixOverrides=",">
