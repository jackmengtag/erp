<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manufacturing.mapper.ErpProductionReportMapper">

    <resultMap type="ErpProductionReport" id="ErpProductionReportResult">
        <result property="reportId"    column="report_id"    />
        <result property="reportCode"    column="report_code"    />
        <result property="moId"    column="mo_id"    />
        <result property="operationId"    column="operation_id"    />
        <result property="reportDate"    column="report_date"    />
        <result property="okQty"    column="ok_qty"    />
        <result property="ngQty"    column="ng_qty"    />
        <result property="reworkQty"    column="rework_qty"    />
        <result property="workHours"    column="work_hours"    />
        <result property="worker"    column="worker"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpProductionReportVo">
        select report_id, report_code, mo_id, operation_id, report_date, ok_qty, ng_qty, rework_qty, work_hours, worker, status, create_by, create_time, update_by, update_time, remark from erp_production_report
    </sql>

    <select id="selectErpProductionReportList" parameterType="ErpProductionReport" resultMap="ErpProductionReportResult">
        <include refid="selectErpProductionReportVo"/>
        <where>
            <if test="reportCode != null  and reportCode != ''"> and report_code like concat('%', #{reportCode}, '%')</if>
            <if test="moId != null "> and mo_id = #{moId}</if>
            <if test="operationId != null "> and operation_id = #{operationId}</if>
            <if test="reportDate != null "> and report_date = #{reportDate}</if>
            <if test="okQty != null "> and ok_qty = #{okQty}</if>
            <if test="ngQty != null "> and ng_qty = #{ngQty}</if>
            <if test="reworkQty != null "> and rework_qty = #{reworkQty}</if>
            <if test="workHours != null "> and work_hours = #{workHours}</if>
            <if test="worker != null  and worker != ''"> and worker = #{worker}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpProductionReportByReportId" parameterType="Long" resultMap="ErpProductionReportResult">
        <include refid="selectErpProductionReportVo"/>
        where report_id = #{reportId}
    </select>

    <insert id="insertErpProductionReport" parameterType="ErpProductionReport" useGeneratedKeys="true" keyProperty="reportId">
        insert into erp_production_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reportCode != null and reportCode != ''">report_code,</if>
            <if test="moId != null">mo_id,</if>
            <if test="operationId != null">operation_id,</if>
            <if test="reportDate != null">report_date,</if>
            <if test="okQty != null">ok_qty,</if>
            <if test="ngQty != null">ng_qty,</if>
            <if test="reworkQty != null">rework_qty,</if>
            <if test="workHours != null">work_hours,</if>
            <if test="worker != null">worker,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reportCode != null and reportCode != ''">#{reportCode},</if>
            <if test="moId != null">#{moId},</if>
            <if test="operationId != null">#{operationId},</if>
            <if test="reportDate != null">#{reportDate},</if>
            <if test="okQty != null">#{okQty},</if>
            <if test="ngQty != null">#{ngQty},</if>
            <if test="reworkQty != null">#{reworkQty},</if>
            <if test="workHours != null">#{workHours},</if>
            <if test="worker != null">#{worker},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpProductionReport" parameterType="ErpProductionReport">
        update erp_production_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="reportCode != null and reportCode != ''">report_code = #{reportCode},</if>
            <if test="moId != null">mo_id = #{moId},</if>
            <if test="operationId != null">operation_id = #{operationId},</if>
            <if test="reportDate != null">report_date = #{reportDate},</if>
            <if test="okQty != null">ok_qty = #{okQty},</if>
            <if test="ngQty != null">ng_qty = #{ngQty},</if>
            <if test="reworkQty != null">rework_qty = #{reworkQty},</if>
            <if test="workHours != null">work_hours = #{workHours},</if>
            <if test="worker != null">worker = #{worker},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where report_id = #{reportId}
    </update>

    <delete id="deleteErpProductionReportByReportId" parameterType="Long">
        delete from erp_production_report where report_id = #{reportId}
    </delete>

    <delete id="deleteErpProductionReportByReportIds" parameterType="String">
        delete from erp_production_report where report_id in
        <foreach item="reportId" collection="array" open="(" separator="," close=")">
            #{reportId}
        </foreach>
    </delete>
</mapper>
