<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpPaymentMapper">

    <resultMap type="ErpPayment" id="ErpPaymentResult">
        <result property="paymentId"    column="payment_id"    />
        <result property="paymentCode"    column="payment_code"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="paymentDate"    column="payment_date"    />
        <result property="amount"    column="amount"    />
        <result property="writeoffAmount"    column="writeoff_amount"    />
        <result property="payMethod"    column="pay_method"    />
        <result property="matchFlag"    column="match_flag"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpPaymentVo">
        select payment_id, payment_code, supplier_id, payment_date, amount, writeoff_amount, pay_method, match_flag, status, create_by, create_time, update_by, update_time, remark from erp_payment
    </sql>

    <select id="selectErpPaymentList" parameterType="ErpPayment" resultMap="ErpPaymentResult">
        <include refid="selectErpPaymentVo"/>
        <where>
            del_flag = '0'
            <if test="paymentCode != null  and paymentCode != ''"> and payment_code like concat('%', #{paymentCode}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="paymentDate != null "> and payment_date = #{paymentDate}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="writeoffAmount != null "> and writeoff_amount = #{writeoffAmount}</if>
            <if test="payMethod != null  and payMethod != ''"> and pay_method = #{payMethod}</if>
            <if test="matchFlag != null  and matchFlag != ''"> and match_flag = #{matchFlag}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpPaymentByPaymentId" parameterType="Long" resultMap="ErpPaymentResult">
        <include refid="selectErpPaymentVo"/>
        where payment_id = #{paymentId}
    </select>

    <insert id="insertErpPayment" parameterType="ErpPayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert into erp_payment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paymentCode != null and paymentCode != ''">payment_code,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="paymentDate != null">payment_date,</if>
            <if test="amount != null">amount,</if>
            <if test="writeoffAmount != null">writeoff_amount,</if>
            <if test="payMethod != null">pay_method,</if>
            <if test="matchFlag != null">match_flag,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paymentCode != null and paymentCode != ''">#{paymentCode},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="paymentDate != null">#{paymentDate},</if>
            <if test="amount != null">#{amount},</if>
            <if test="writeoffAmount != null">#{writeoffAmount},</if>
            <if test="payMethod != null">#{payMethod},</if>
            <if test="matchFlag != null">#{matchFlag},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpPayment" parameterType="ErpPayment">
        update erp_payment
        <trim prefix="SET" suffixOverrides=",">
            <if test="paymentCode != null and paymentCode != ''">payment_code = #{paymentCode},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="paymentDate != null">payment_date = #{paymentDate},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="writeoffAmount != null">writeoff_amount = #{writeoffAmount},</if>
            <if test="payMethod != null">pay_method = #{payMethod},</if>
            <if test="matchFlag != null">match_flag = #{matchFlag},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where payment_id = #{paymentId}
    </update>

    <delete id="deleteErpPaymentByPaymentId" parameterType="Long">
        update erp_payment set del_flag = '2' where payment_id = #{paymentId}
    </delete>

    <delete id="deleteErpPaymentByPaymentIds" parameterType="String">
        update erp_payment set del_flag = '2' where payment_id in
        <foreach item="paymentId" collection="array" open="(" separator="," close=")">
            #{paymentId}
        </foreach>
    </delete>
</mapper>
