<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.plan.mapper.ErpMrpRunMapper">

    <resultMap type="ErpMrpRun" id="ErpMrpRunResult">
        <result property="runId"    column="run_id"    />
        <result property="runCode"    column="run_code"    />
        <result property="runDate"    column="run_date"    />
        <result property="runType"    column="run_type"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpMrpRunVo">
        select run_id, run_code, run_date, run_type, status, create_by, create_time, update_time, remark from erp_mrp_run
    </sql>

    <select id="selectErpMrpRunList" parameterType="ErpMrpRun" resultMap="ErpMrpRunResult">
        <include refid="selectErpMrpRunVo"/>
        <where>
            <if test="runCode != null  and runCode != ''"> and run_code like concat('%', #{runCode}, '%')</if>
            <if test="runDate != null "> and run_date = #{runDate}</if>
            <if test="runType != null  and runType != ''"> and run_type = #{runType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpMrpRunByRunId" parameterType="Long" resultMap="ErpMrpRunResult">
        <include refid="selectErpMrpRunVo"/>
        where run_id = #{runId}
    </select>

    <insert id="insertErpMrpRun" parameterType="ErpMrpRun" useGeneratedKeys="true" keyProperty="runId">
        insert into erp_mrp_run
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="runCode != null and runCode != ''">run_code,</if>
            <if test="runDate != null">run_date,</if>
            <if test="runType != null">run_type,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="runCode != null and runCode != ''">#{runCode},</if>
            <if test="runDate != null">#{runDate},</if>
            <if test="runType != null">#{runType},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpMrpRun" parameterType="ErpMrpRun">
        update erp_mrp_run
        <trim prefix="SET" suffixOverrides=",">
            <if test="runCode != null and runCode != ''">run_code = #{runCode},</if>
            <if test="runDate != null">run_date = #{runDate},</if>
            <if test="runType != null">run_type = #{runType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where run_id = #{runId}
    </update>

    <delete id="deleteErpMrpRunByRunId" parameterType="Long">
        delete from erp_mrp_run where run_id = #{runId}
    </delete>

    <delete id="deleteErpMrpRunByRunIds" parameterType="String">
        delete from erp_mrp_run where run_id in
        <foreach item="runId" collection="array" open="(" separator="," close=")">
            #{runId}
        </foreach>
    </delete>
</mapper>
