<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.mapper.ErpCustomerMapper">

    <resultMap type="ErpCustomer" id="ErpCustomerResult">
        <result property="customerId"    column="customer_id"    />
        <result property="customerCode"    column="customer_code"    />
        <result property="customerName"    column="customer_name"    />
        <result property="shortName"    column="short_name"    />
        <result property="customerLevel"    column="customer_level"    />
        <result property="contactPerson"    column="contact_person"    />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="address"    column="address"    />
        <result property="creditLimit"    column="credit_limit"    />
        <result property="creditDays"    column="credit_days"    />
        <result property="taxNo"    column="tax_no"    />
        <result property="bankAccount"    column="bank_account"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpCustomerVo">
        select customer_id, customer_code, customer_name, short_name, customer_level, contact_person, contact_phone, address, credit_limit, credit_days, tax_no, bank_account, status, create_by, create_time, update_by, update_time, remark from erp_customer
    </sql>

    <select id="selectErpCustomerList" parameterType="ErpCustomer" resultMap="ErpCustomerResult">
        <include refid="selectErpCustomerVo"/>
        <where>
            del_flag = '0'
            <if test="customerCode != null  and customerCode != ''"> and customer_code like concat('%', #{customerCode}, '%')</if>
            <if test="customerName != null  and customerName != ''"> and customer_name like concat('%', #{customerName}, '%')</if>
            <if test="shortName != null  and shortName != ''"> and short_name = #{shortName}</if>
            <if test="customerLevel != null  and customerLevel != ''"> and customer_level = #{customerLevel}</if>
            <if test="contactPerson != null  and contactPerson != ''"> and contact_person = #{contactPerson}</if>
            <if test="contactPhone != null  and contactPhone != ''"> and contact_phone = #{contactPhone}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="creditLimit != null "> and credit_limit = #{creditLimit}</if>
            <if test="creditDays != null "> and credit_days = #{creditDays}</if>
            <if test="taxNo != null  and taxNo != ''"> and tax_no = #{taxNo}</if>
            <if test="bankAccount != null  and bankAccount != ''"> and bank_account = #{bankAccount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpCustomerByCustomerId" parameterType="Long" resultMap="ErpCustomerResult">
        <include refid="selectErpCustomerVo"/>
        where customer_id = #{customerId}
    </select>

    <insert id="insertErpCustomer" parameterType="ErpCustomer" useGeneratedKeys="true" keyProperty="customerId">
        insert into erp_customer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerCode != null and customerCode != ''">customer_code,</if>
            <if test="customerName != null and customerName != ''">customer_name,</if>
            <if test="shortName != null">short_name,</if>
            <if test="customerLevel != null">customer_level,</if>
            <if test="contactPerson != null">contact_person,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="address != null">address,</if>
            <if test="creditLimit != null">credit_limit,</if>
            <if test="creditDays != null">credit_days,</if>
            <if test="taxNo != null">tax_no,</if>
            <if test="bankAccount != null">bank_account,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerCode != null and customerCode != ''">#{customerCode},</if>
            <if test="customerName != null and customerName != ''">#{customerName},</if>
            <if test="shortName != null">#{shortName},</if>
            <if test="customerLevel != null">#{customerLevel},</if>
            <if test="contactPerson != null">#{contactPerson},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="address != null">#{address},</if>
            <if test="creditLimit != null">#{creditLimit},</if>
            <if test="creditDays != null">#{creditDays},</if>
            <if test="taxNo != null">#{taxNo},</if>
            <if test="bankAccount != null">#{bankAccount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpCustomer" parameterType="ErpCustomer">
        update erp_customer
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerCode != null and customerCode != ''">customer_code = #{customerCode},</if>
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="shortName != null">short_name = #{shortName},</if>
            <if test="customerLevel != null">customer_level = #{customerLevel},</if>
            <if test="contactPerson != null">contact_person = #{contactPerson},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="creditLimit != null">credit_limit = #{creditLimit},</if>
            <if test="creditDays != null">credit_days = #{creditDays},</if>
            <if test="taxNo != null">tax_no = #{taxNo},</if>
            <if test="bankAccount != null">bank_account = #{bankAccount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where customer_id = #{customerId}
    </update>

    <delete id="deleteErpCustomerByCustomerId" parameterType="Long">
        update erp_customer set del_flag = '2' where customer_id = #{customerId}
    </delete>

    <delete id="deleteErpCustomerByCustomerIds" parameterType="String">
        update erp_customer set del_flag = '2' where customer_id in
        <foreach item="customerId" collection="array" open="(" separator="," close=")">
            #{customerId}
        </foreach>
    </delete>
</mapper>
