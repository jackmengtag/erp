<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.sales.mapper.ErpSalesReturnMapper">

    <resultMap type="ErpSalesReturn" id="ErpSalesReturnResult">
        <result property="returnId"    column="return_id"    />
        <result property="returnCode"    column="return_code"    />
        <result property="customerId"    column="customer_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="returnDate"    column="return_date"    />
        <result property="returnReason"    column="return_reason"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpSalesReturnErpSalesReturnLineResult" type="ErpSalesReturn" extends="ErpSalesReturnResult">
        <collection property="erpSalesReturnLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpSalesReturnLineResult" />
    </resultMap>

    <resultMap type="ErpSalesReturnLine" id="ErpSalesReturnLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="returnId"    column="sub_return_id"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="batchNo"    column="sub_batch_no"    />
        <result property="qty"    column="sub_qty"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpSalesReturnVo">
        select return_id, return_code, customer_id, order_id, warehouse_id, return_date, return_reason, status, create_by, create_time, update_by, update_time, remark from erp_sales_return
    </sql>

    <select id="selectErpSalesReturnList" parameterType="ErpSalesReturn" resultMap="ErpSalesReturnResult">
        <include refid="selectErpSalesReturnVo"/>
        <where>
            del_flag = '0'
            <if test="returnCode != null  and returnCode != ''"> and return_code like concat('%', #{returnCode}, '%')</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="returnDate != null "> and return_date = #{returnDate}</if>
            <if test="returnReason != null  and returnReason != ''"> and return_reason like concat('%', #{returnReason}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpSalesReturnByReturnId" parameterType="Long" resultMap="ErpSalesReturnErpSalesReturnLineResult">
        select a.return_id, a.return_code, a.customer_id, a.order_id, a.warehouse_id, a.return_date, a.return_reason, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.return_id as sub_return_id, b.line_no as sub_line_no, b.material_id as sub_material_id, b.batch_no as sub_batch_no, b.qty as sub_qty, b.create_time as sub_create_time
        from erp_sales_return a
        left join erp_sales_return_line b on b.return_id = a.return_id
        where a.return_id = #{returnId}
    </select>

    <insert id="insertErpSalesReturn" parameterType="ErpSalesReturn" useGeneratedKeys="true" keyProperty="returnId">
        insert into erp_sales_return
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnCode != null and returnCode != ''">return_code,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="returnDate != null">return_date,</if>
            <if test="returnReason != null">return_reason,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnCode != null and returnCode != ''">#{returnCode},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="returnDate != null">#{returnDate},</if>
            <if test="returnReason != null">#{returnReason},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpSalesReturn" parameterType="ErpSalesReturn">
        update erp_sales_return
        <trim prefix="SET" suffixOverrides=",">
            <if test="returnCode != null and returnCode != ''">return_code = #{returnCode},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="returnDate != null">return_date = #{returnDate},</if>
            <if test="returnReason != null">return_reason = #{returnReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where return_id = #{returnId}
    </update>

    <delete id="deleteErpSalesReturnByReturnId" parameterType="Long">
        update erp_sales_return set del_flag = '2' where return_id = #{returnId}
    </delete>

    <delete id="deleteErpSalesReturnByReturnIds" parameterType="String">
        update erp_sales_return set del_flag = '2' where return_id in
        <foreach item="returnId" collection="array" open="(" separator="," close=")">
            #{returnId}
        </foreach>
    </delete>

    <delete id="deleteErpSalesReturnLineByReturnId" parameterType="Long">
        delete from erp_sales_return_line where return_id = #{returnId}
    </delete>

    <delete id="deleteErpSalesReturnLineByReturnIds" parameterType="String">
        delete from erp_sales_return_line where return_id in
        <foreach item="returnId" collection="array" open="(" separator="," close=")">
            #{returnId}
        </foreach>
    </delete>

    <insert id="batchErpSalesReturnLine">
        insert into erp_sales_return_line( line_id, return_id, line_no, material_id, batch_no, qty, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.returnId}, #{item.lineNo}, #{item.materialId}, #{item.batchNo}, #{item.qty}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
