<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.inventory.mapper.ErpInventoryReserveMapper">

    <resultMap type="ErpInventoryReserve" id="ErpInventoryReserveResult">
        <result property="reserveId"    column="reserve_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="qty"    column="qty"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="sourceCode"    column="source_code"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectErpInventoryReserveVo">
        select reserve_id, material_id, warehouse_id, batch_no, qty, source_type, source_id, source_code, status, create_by, create_time, update_time from erp_inventory_reserve
    </sql>

    <select id="selectErpInventoryReserveList" parameterType="ErpInventoryReserve" resultMap="ErpInventoryReserveResult">
        <include refid="selectErpInventoryReserveVo"/>
        <where>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="qty != null "> and qty = #{qty}</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="sourceCode != null  and sourceCode != ''"> and source_code = #{sourceCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpInventoryReserveByReserveId" parameterType="Long" resultMap="ErpInventoryReserveResult">
        <include refid="selectErpInventoryReserveVo"/>
        where reserve_id = #{reserveId}
    </select>

    <insert id="insertErpInventoryReserve" parameterType="ErpInventoryReserve" useGeneratedKeys="true" keyProperty="reserveId">
        insert into erp_inventory_reserve
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="materialId != null">material_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="qty != null">qty,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="sourceCode != null">source_code,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="materialId != null">#{materialId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="qty != null">#{qty},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="sourceCode != null">#{sourceCode},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateErpInventoryReserve" parameterType="ErpInventoryReserve">
        update erp_inventory_reserve
        <trim prefix="SET" suffixOverrides=",">
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="sourceCode != null">source_code = #{sourceCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where reserve_id = #{reserveId}
    </update>

    <delete id="deleteErpInventoryReserveByReserveId" parameterType="Long">
        delete from erp_inventory_reserve where reserve_id = #{reserveId}
    </delete>

    <delete id="deleteErpInventoryReserveByReserveIds" parameterType="String">
        delete from erp_inventory_reserve where reserve_id in
        <foreach item="reserveId" collection="array" open="(" separator="," close=")">
            #{reserveId}
        </foreach>
    </delete>
</mapper>
