<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpReceiptMapper">

    <resultMap type="ErpReceipt" id="ErpReceiptResult">
        <result property="receiptId"    column="receipt_id"    />
        <result property="receiptCode"    column="receipt_code"    />
        <result property="customerId"    column="customer_id"    />
        <result property="receiptDate"    column="receipt_date"    />
        <result property="amount"    column="amount"    />
        <result property="writeoffAmount"    column="writeoff_amount"    />
        <result property="payMethod"    column="pay_method"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpReceiptVo">
        select receipt_id, receipt_code, customer_id, receipt_date, amount, writeoff_amount, pay_method, status, create_by, create_time, update_by, update_time, remark from erp_receipt
    </sql>

    <select id="selectErpReceiptList" parameterType="ErpReceipt" resultMap="ErpReceiptResult">
        <include refid="selectErpReceiptVo"/>
        <where>
            del_flag = '0'
            <if test="receiptCode != null  and receiptCode != ''"> and receipt_code like concat('%', #{receiptCode}, '%')</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="receiptDate != null "> and receipt_date = #{receiptDate}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="writeoffAmount != null "> and writeoff_amount = #{writeoffAmount}</if>
            <if test="payMethod != null  and payMethod != ''"> and pay_method = #{payMethod}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpReceiptByReceiptId" parameterType="Long" resultMap="ErpReceiptResult">
        <include refid="selectErpReceiptVo"/>
        where receipt_id = #{receiptId}
    </select>

    <insert id="insertErpReceipt" parameterType="ErpReceipt" useGeneratedKeys="true" keyProperty="receiptId">
        insert into erp_receipt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">receipt_code,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="receiptDate != null">receipt_date,</if>
            <if test="amount != null">amount,</if>
            <if test="writeoffAmount != null">writeoff_amount,</if>
            <if test="payMethod != null">pay_method,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">#{receiptCode},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="receiptDate != null">#{receiptDate},</if>
            <if test="amount != null">#{amount},</if>
            <if test="writeoffAmount != null">#{writeoffAmount},</if>
            <if test="payMethod != null">#{payMethod},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpReceipt" parameterType="ErpReceipt">
        update erp_receipt
        <trim prefix="SET" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">receipt_code = #{receiptCode},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="receiptDate != null">receipt_date = #{receiptDate},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="writeoffAmount != null">writeoff_amount = #{writeoffAmount},</if>
            <if test="payMethod != null">pay_method = #{payMethod},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where receipt_id = #{receiptId}
    </update>

    <delete id="deleteErpReceiptByReceiptId" parameterType="Long">
        update erp_receipt set del_flag = '2' where receipt_id = #{receiptId}
    </delete>

    <delete id="deleteErpReceiptByReceiptIds" parameterType="String">
        update erp_receipt set del_flag = '2' where receipt_id in
        <foreach item="receiptId" collection="array" open="(" separator="," close=")">
            #{receiptId}
        </foreach>
    </delete>
</mapper>
