    <delete id="deleteErpInventoryTxnByTxnId" parameterType="Long">
        delete from erp_inventory_txn where txn_id = #{txnId}
    </delete>

    <delete id="deleteErpInventoryTxnByTxnIds" parameterType="String">
        delete from erp_inventory_txn where txn_id in
        <foreach item="txnId" collection="array" open="(" separator="," close=")">
            #{txnId}
        </foreach>
    </delete>
