<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.purchase.mapper.ErpGoodsReceiptMapper">

    <resultMap type="ErpGoodsReceipt" id="ErpGoodsReceiptResult">
        <result property="receiptId"    column="receipt_id"    />
        <result property="receiptCode"    column="receipt_code"    />
        <result property="poId"    column="po_id"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="receiptDate"    column="receipt_date"    />
        <result property="inspectStatus"    column="inspect_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpGoodsReceiptErpGoodsReceiptLineResult" type="ErpGoodsReceipt" extends="ErpGoodsReceiptResult">
        <collection property="erpGoodsReceiptLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpGoodsReceiptLineResult" />
    </resultMap>

    <resultMap type="ErpGoodsReceiptLine" id="ErpGoodsReceiptLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="receiptId"    column="sub_receipt_id"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="batchNo"    column="sub_batch_no"    />
        <result property="qty"    column="sub_qty"    />
        <result property="qualifiedQty"    column="sub_qualified_qty"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpGoodsReceiptVo">
        select receipt_id, receipt_code, po_id, supplier_id, warehouse_id, receipt_date, inspect_status, status, create_by, create_time, update_by, update_time, remark from erp_goods_receipt
    </sql>

    <select id="selectErpGoodsReceiptList" parameterType="ErpGoodsReceipt" resultMap="ErpGoodsReceiptResult">
        <include refid="selectErpGoodsReceiptVo"/>
        <where>
            del_flag = '0'
            <if test="receiptCode != null  and receiptCode != ''"> and receipt_code like concat('%', #{receiptCode}, '%')</if>
            <if test="poId != null "> and po_id = #{poId}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="receiptDate != null "> and receipt_date = #{receiptDate}</if>
            <if test="inspectStatus != null  and inspectStatus != ''"> and inspect_status = #{inspectStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpGoodsReceiptByReceiptId" parameterType="Long" resultMap="ErpGoodsReceiptErpGoodsReceiptLineResult">
        select a.receipt_id, a.receipt_code, a.po_id, a.supplier_id, a.warehouse_id, a.receipt_date, a.inspect_status, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.receipt_id as sub_receipt_id, b.line_no as sub_line_no, b.material_id as sub_material_id, b.batch_no as sub_batch_no, b.qty as sub_qty, b.qualified_qty as sub_qualified_qty, b.create_time as sub_create_time
        from erp_goods_receipt a
        left join erp_goods_receipt_line b on b.receipt_id = a.receipt_id
        where a.receipt_id = #{receiptId}
    </select>

    <insert id="insertErpGoodsReceipt" parameterType="ErpGoodsReceipt" useGeneratedKeys="true" keyProperty="receiptId">
        insert into erp_goods_receipt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">receipt_code,</if>
            <if test="poId != null">po_id,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="receiptDate != null">receipt_date,</if>
            <if test="inspectStatus != null">inspect_status,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">#{receiptCode},</if>
            <if test="poId != null">#{poId},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="receiptDate != null">#{receiptDate},</if>
            <if test="inspectStatus != null">#{inspectStatus},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpGoodsReceipt" parameterType="ErpGoodsReceipt">
        update erp_goods_receipt
        <trim prefix="SET" suffixOverrides=",">
            <if test="receiptCode != null and receiptCode != ''">receipt_code = #{receiptCode},</if>
            <if test="poId != null">po_id = #{poId},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="receiptDate != null">receipt_date = #{receiptDate},</if>
            <if test="inspectStatus != null">inspect_status = #{inspectStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where receipt_id = #{receiptId}
    </update>

    <delete id="deleteErpGoodsReceiptByReceiptId" parameterType="Long">
        update erp_goods_receipt set del_flag = '2' where receipt_id = #{receiptId}
    </delete>

    <delete id="deleteErpGoodsReceiptByReceiptIds" parameterType="String">
        update erp_goods_receipt set del_flag = '2' where receipt_id in
        <foreach item="receiptId" collection="array" open="(" separator="," close=")">
            #{receiptId}
        </foreach>
    </delete>

    <delete id="deleteErpGoodsReceiptLineByReceiptId" parameterType="Long">
        delete from erp_goods_receipt_line where receipt_id = #{receiptId}
    </delete>

    <delete id="deleteErpGoodsReceiptLineByReceiptIds" parameterType="String">
        delete from erp_goods_receipt_line where receipt_id in
        <foreach item="receiptId" collection="array" open="(" separator="," close=")">
            #{receiptId}
        </foreach>
    </delete>

    <insert id="batchErpGoodsReceiptLine">
        insert into erp_goods_receipt_line( line_id, receipt_id, line_no, material_id, batch_no, qty, qualified_qty, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.receiptId}, #{item.lineNo}, #{item.materialId}, #{item.batchNo}, #{item.qty}, #{item.qualifiedQty}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
