<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.quality.mapper.ErpInspectionOrderMapper">

    <resultMap type="ErpInspectionOrder" id="ErpInspectionOrderResult">
        <result property="inspectId"    column="inspect_id"    />
        <result property="inspectCode"    column="inspect_code"    />
        <result property="inspectType"    column="inspect_type"    />
        <result property="planId"    column="plan_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="inspectQty"    column="inspect_qty"    />
        <result property="qualifiedQty"    column="qualified_qty"    />
        <result property="unqualifiedQty"    column="unqualified_qty"    />
        <result property="inspectResult"    column="inspect_result"    />
        <result property="inspector"    column="inspector"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpInspectionOrderErpInspectionResultResult" type="ErpInspectionOrder" extends="ErpInspectionOrderResult">
        <collection property="erpInspectionResultList" notNullColumn="sub_result_id" javaType="java.util.List" resultMap="ErpInspectionResultResult" />
    </resultMap>

    <resultMap type="ErpInspectionResult" id="ErpInspectionResultResult">
        <result property="resultId"    column="sub_result_id"    />
        <result property="inspectId"    column="sub_inspect_id"    />
        <result property="itemName"    column="sub_item_name"    />
        <result property="standardValue"    column="sub_standard_value"    />
        <result property="inspectValue"    column="sub_inspect_value"    />
        <result property="judgeResult"    column="sub_judge_result"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpInspectionOrderVo">
        select inspect_id, inspect_code, inspect_type, plan_id, material_id, batch_no, source_type, source_id, inspect_qty, qualified_qty, unqualified_qty, inspect_result, inspector, status, create_by, create_time, update_by, update_time, remark from erp_inspection_order
    </sql>

    <select id="selectErpInspectionOrderList" parameterType="ErpInspectionOrder" resultMap="ErpInspectionOrderResult">
        <include refid="selectErpInspectionOrderVo"/>
        <where>
            del_flag = '0'
            <if test="inspectCode != null  and inspectCode != ''"> and inspect_code like concat('%', #{inspectCode}, '%')</if>
            <if test="inspectType != null  and inspectType != ''"> and inspect_type = #{inspectType}</if>
            <if test="planId != null "> and plan_id = #{planId}</if>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="batchNo != null  and batchNo != ''"> and batch_no like concat('%', #{batchNo}, '%')</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="inspectResult != null  and inspectResult != ''"> and inspect_result = #{inspectResult}</if>
            <if test="inspector != null  and inspector != ''"> and inspector = #{inspector}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpInspectionOrderByInspectId" parameterType="Long" resultMap="ErpInspectionOrderErpInspectionResultResult">
        select a.inspect_id, a.inspect_code, a.inspect_type, a.plan_id, a.material_id, a.batch_no, a.source_type, a.source_id, a.inspect_qty, a.qualified_qty, a.unqualified_qty, a.inspect_result, a.inspector, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.result_id as sub_result_id, b.inspect_id as sub_inspect_id, b.item_name as sub_item_name, b.standard_value as sub_standard_value, b.inspect_value as sub_inspect_value, b.judge_result as sub_judge_result, b.create_time as sub_create_time
        from erp_inspection_order a
        left join erp_inspection_result b on b.inspect_id = a.inspect_id
        where a.inspect_id = #{inspectId}
    </select>

    <insert id="insertErpInspectionOrder" parameterType="ErpInspectionOrder" useGeneratedKeys="true" keyProperty="inspectId">
        insert into erp_inspection_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inspectCode != null and inspectCode != ''">inspect_code,</if>
            <if test="inspectType != null">inspect_type,</if>
            <if test="planId != null">plan_id,</if>
            <if test="materialId != null">material_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="inspectQty != null">inspect_qty,</if>
            <if test="qualifiedQty != null">qualified_qty,</if>
            <if test="unqualifiedQty != null">unqualified_qty,</if>
            <if test="inspectResult != null">inspect_result,</if>
            <if test="inspector != null">inspector,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inspectCode != null and inspectCode != ''">#{inspectCode},</if>
            <if test="inspectType != null">#{inspectType},</if>
            <if test="planId != null">#{planId},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="inspectQty != null">#{inspectQty},</if>
            <if test="qualifiedQty != null">#{qualifiedQty},</if>
            <if test="unqualifiedQty != null">#{unqualifiedQty},</if>
            <if test="inspectResult != null">#{inspectResult},</if>
            <if test="inspector != null">#{inspector},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpInspectionOrder" parameterType="ErpInspectionOrder">
        update erp_inspection_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="inspectCode != null and inspectCode != ''">inspect_code = #{inspectCode},</if>
            <if test="inspectType != null">inspect_type = #{inspectType},</if>
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="inspectQty != null">inspect_qty = #{inspectQty},</if>
            <if test="qualifiedQty != null">qualified_qty = #{qualifiedQty},</if>
            <if test="unqualifiedQty != null">unqualified_qty = #{unqualifiedQty},</if>
            <if test="inspectResult != null">inspect_result = #{inspectResult},</if>
            <if test="inspector != null">inspector = #{inspector},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where inspect_id = #{inspectId}
    </update>

    <delete id="deleteErpInspectionOrderByInspectId" parameterType="Long">
        update erp_inspection_order set del_flag = '2' where inspect_id = #{inspectId}
    </delete>

    <delete id="deleteErpInspectionOrderByInspectIds" parameterType="String">
        update erp_inspection_order set del_flag = '2' where inspect_id in
        <foreach item="inspectId" collection="array" open="(" separator="," close=")">
            #{inspectId}
        </foreach>
    </delete>

    <delete id="deleteErpInspectionResultByInspectId" parameterType="Long">
        delete from erp_inspection_result where inspect_id = #{inspectId}
    </delete>

    <delete id="deleteErpInspectionResultByInspectIds" parameterType="String">
        delete from erp_inspection_result where inspect_id in
        <foreach item="inspectId" collection="array" open="(" separator="," close=")">
            #{inspectId}
        </foreach>
    </delete>

    <insert id="batchErpInspectionResult">
        insert into erp_inspection_result( result_id, inspect_id, item_name, standard_value, inspect_value, judge_result, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.resultId}, #{item.inspectId}, #{item.itemName}, #{item.standardValue}, #{item.inspectValue}, #{item.judgeResult}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
