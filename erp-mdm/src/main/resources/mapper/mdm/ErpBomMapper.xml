<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.mapper.ErpBomMapper">

    <resultMap type="ErpBom" id="ErpBomResult">
        <result property="bomId"    column="bom_id"    />
        <result property="bomCode"    column="bom_code"    />
        <result property="materialId"    column="material_id"    />
        <result property="version"    column="version"    />
        <result property="effectDate"    column="effect_date"    />
        <result property="expireDate"    column="expire_date"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpBomErpBomLineResult" type="ErpBom" extends="ErpBomResult">
        <collection property="erpBomLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpBomLineResult" />
    </resultMap>

    <resultMap type="ErpBomLine" id="ErpBomLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="bomId"    column="sub_bom_id"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="qtyPer"    column="sub_qty_per"    />
        <result property="lossRate"    column="sub_loss_rate"    />
        <result property="substituteFlag"    column="sub_substitute_flag"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpBomVo">
        select bom_id, bom_code, material_id, version, effect_date, expire_date, status, create_by, create_time, update_by, update_time, remark from erp_bom
    </sql>

    <select id="selectErpBomList" parameterType="ErpBom" resultMap="ErpBomResult">
        <include refid="selectErpBomVo"/>
        <where>
            del_flag = '0'
            <if test="bomCode != null  and bomCode != ''"> and bom_code like concat('%', #{bomCode}, '%')</if>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="version != null  and version != ''"> and version = #{version}</if>
            <if test="effectDate != null "> and effect_date = #{effectDate}</if>
            <if test="expireDate != null "> and expire_date = #{expireDate}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpBomByBomId" parameterType="Long" resultMap="ErpBomErpBomLineResult">
        select a.bom_id, a.bom_code, a.material_id, a.version, a.effect_date, a.expire_date, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.bom_id as sub_bom_id, b.material_id as sub_material_id, b.qty_per as sub_qty_per, b.loss_rate as sub_loss_rate, b.substitute_flag as sub_substitute_flag, b.line_no as sub_line_no, b.create_time as sub_create_time
        from erp_bom a
        left join erp_bom_line b on b.bom_id = a.bom_id
        where a.bom_id = #{bomId}
    </select>

    <insert id="insertErpBom" parameterType="ErpBom" useGeneratedKeys="true" keyProperty="bomId">
        insert into erp_bom
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bomCode != null and bomCode != ''">bom_code,</if>
            <if test="materialId != null">material_id,</if>
            <if test="version != null">version,</if>
            <if test="effectDate != null">effect_date,</if>
            <if test="expireDate != null">expire_date,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bomCode != null and bomCode != ''">#{bomCode},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="version != null">#{version},</if>
            <if test="effectDate != null">#{effectDate},</if>
            <if test="expireDate != null">#{expireDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpBom" parameterType="ErpBom">
        update erp_bom
        <trim prefix="SET" suffixOverrides=",">
            <if test="bomCode != null and bomCode != ''">bom_code = #{bomCode},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="version != null">version = #{version},</if>
            <if test="effectDate != null">effect_date = #{effectDate},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where bom_id = #{bomId}
    </update>

    <delete id="deleteErpBomByBomId" parameterType="Long">
        update erp_bom set del_flag = '2' where bom_id = #{bomId}
    </delete>

    <delete id="deleteErpBomByBomIds" parameterType="String">
        update erp_bom set del_flag = '2' where bom_id in
        <foreach item="bomId" collection="array" open="(" separator="," close=")">
            #{bomId}
        </foreach>
    </delete>

    <delete id="deleteErpBomLineByBomId" parameterType="Long">
        delete from erp_bom_line where bom_id = #{bomId}
    </delete>

    <delete id="deleteErpBomLineByBomIds" parameterType="String">
        delete from erp_bom_line where bom_id in
        <foreach item="bomId" collection="array" open="(" separator="," close=")">
            #{bomId}
        </foreach>
    </delete>

    <insert id="batchErpBomLine">
        insert into erp_bom_line( line_id, bom_id, material_id, qty_per, loss_rate, substitute_flag, line_no, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.bomId}, #{item.materialId}, #{item.qtyPer}, #{item.lossRate}, #{item.substituteFlag}, #{item.lineNo}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
