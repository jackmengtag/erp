<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.purchase.mapper.ErpPurchaseOrderMapper">

    <resultMap type="ErpPurchaseOrder" id="ErpPurchaseOrderResult">
        <result property="poId"    column="po_id"    />
        <result property="poCode"    column="po_code"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="orderDate"    column="order_date"    />
        <result property="deliveryDate"    column="delivery_date"    />
        <result property="currency"    column="currency"    />
        <result property="amountTax"    column="amount_tax"    />
        <result property="amountNotax"    column="amount_notax"    />
        <result property="matchStatus"    column="match_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpPurchaseOrderErpPurchaseOrderLineResult" type="ErpPurchaseOrder" extends="ErpPurchaseOrderResult">
        <collection property="erpPurchaseOrderLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpPurchaseOrderLineResult" />
    </resultMap>

    <resultMap type="ErpPurchaseOrderLine" id="ErpPurchaseOrderLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="poId"    column="sub_po_id"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="qty"    column="sub_qty"    />
        <result property="receivedQty"    column="sub_received_qty"    />
        <result property="price"    column="sub_price"    />
        <result property="taxRate"    column="sub_tax_rate"    />
        <result property="amount"    column="sub_amount"    />
        <result property="deliveryDate"    column="sub_delivery_date"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpPurchaseOrderVo">
        select po_id, po_code, supplier_id, order_date, delivery_date, currency, amount_tax, amount_notax, match_status, status, create_by, create_time, update_by, update_time, remark from erp_purchase_order
    </sql>

    <select id="selectErpPurchaseOrderList" parameterType="ErpPurchaseOrder" resultMap="ErpPurchaseOrderResult">
        <include refid="selectErpPurchaseOrderVo"/>
        <where>
            del_flag = '0'
            <if test="poCode != null  and poCode != ''"> and po_code like concat('%', #{poCode}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="orderDate != null "> and order_date = #{orderDate}</if>
            <if test="deliveryDate != null "> and delivery_date = #{deliveryDate}</if>
            <if test="currency != null  and currency != ''"> and currency = #{currency}</if>
            <if test="matchStatus != null  and matchStatus != ''"> and match_status = #{matchStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpPurchaseOrderByPoId" parameterType="Long" resultMap="ErpPurchaseOrderErpPurchaseOrderLineResult">
        select a.po_id, a.po_code, a.supplier_id, a.order_date, a.delivery_date, a.currency, a.amount_tax, a.amount_notax, a.match_status, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.po_id as sub_po_id, b.line_no as sub_line_no, b.material_id as sub_material_id, b.qty as sub_qty, b.received_qty as sub_received_qty, b.price as sub_price, b.tax_rate as sub_tax_rate, b.amount as sub_amount, b.delivery_date as sub_delivery_date, b.create_time as sub_create_time
        from erp_purchase_order a
        left join erp_purchase_order_line b on b.po_id = a.po_id
        where a.po_id = #{poId}
    </select>

    <insert id="insertErpPurchaseOrder" parameterType="ErpPurchaseOrder" useGeneratedKeys="true" keyProperty="poId">
        insert into erp_purchase_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="poCode != null and poCode != ''">po_code,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="orderDate != null">order_date,</if>
            <if test="deliveryDate != null">delivery_date,</if>
            <if test="currency != null">currency,</if>
            <if test="amountTax != null">amount_tax,</if>
            <if test="amountNotax != null">amount_notax,</if>
            <if test="matchStatus != null">match_status,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="poCode != null and poCode != ''">#{poCode},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="orderDate != null">#{orderDate},</if>
            <if test="deliveryDate != null">#{deliveryDate},</if>
            <if test="currency != null">#{currency},</if>
            <if test="amountTax != null">#{amountTax},</if>
            <if test="amountNotax != null">#{amountNotax},</if>
            <if test="matchStatus != null">#{matchStatus},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpPurchaseOrder" parameterType="ErpPurchaseOrder">
        update erp_purchase_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="poCode != null and poCode != ''">po_code = #{poCode},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="orderDate != null">order_date = #{orderDate},</if>
            <if test="deliveryDate != null">delivery_date = #{deliveryDate},</if>
            <if test="currency != null">currency = #{currency},</if>
            <if test="amountTax != null">amount_tax = #{amountTax},</if>
            <if test="amountNotax != null">amount_notax = #{amountNotax},</if>
            <if test="matchStatus != null">match_status = #{matchStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where po_id = #{poId}
    </update>

    <delete id="deleteErpPurchaseOrderByPoId" parameterType="Long">
        update erp_purchase_order set del_flag = '2' where po_id = #{poId}
    </delete>

    <delete id="deleteErpPurchaseOrderByPoIds" parameterType="String">
        update erp_purchase_order set del_flag = '2' where po_id in
        <foreach item="poId" collection="array" open="(" separator="," close=")">
            #{poId}
        </foreach>
    </delete>

    <delete id="deleteErpPurchaseOrderLineByPoId" parameterType="Long">
        delete from erp_purchase_order_line where po_id = #{poId}
    </delete>

    <delete id="deleteErpPurchaseOrderLineByPoIds" parameterType="String">
        delete from erp_purchase_order_line where po_id in
        <foreach item="poId" collection="array" open="(" separator="," close=")">
            #{poId}
        </foreach>
    </delete>

    <insert id="batchErpPurchaseOrderLine">
        insert into erp_purchase_order_line( line_id, po_id, line_no, material_id, qty, received_qty, price, tax_rate, amount, delivery_date, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.poId}, #{item.lineNo}, #{item.materialId}, #{item.qty}, #{item.receivedQty}, #{item.price}, #{item.taxRate}, #{item.amount}, #{item.deliveryDate}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
