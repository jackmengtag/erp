<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.inventory.mapper.ErpInventoryMapper">

    <resultMap type="ErpInventory" id="ErpInventoryResult">
        <result property="inventoryId"    column="inventory_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="locationId"    column="location_id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="stockQty"    column="stock_qty"    />
        <result property="availableQty"    column="available_qty"    />
        <result property="reservedQty"    column="reserved_qty"    />
        <result property="inspectQty"    column="inspect_qty"    />
        <result property="frozenQty"    column="frozen_qty"    />
        <result property="costPrice"    column="cost_price"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectErpInventoryVo">
        select inventory_id, material_id, warehouse_id, location_id, batch_no, stock_qty, available_qty, reserved_qty, inspect_qty, frozen_qty, cost_price, create_time, update_time from erp_inventory
    </sql>

    <select id="selectErpInventoryList" parameterType="ErpInventory" resultMap="ErpInventoryResult">
        <include refid="selectErpInventoryVo"/>
        <where>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="locationId != null "> and location_id = #{locationId}</if>
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="stockQty != null "> and stock_qty = #{stockQty}</if>
            <if test="availableQty != null "> and available_qty = #{availableQty}</if>
            <if test="reservedQty != null "> and reserved_qty = #{reservedQty}</if>
            <if test="inspectQty != null "> and inspect_qty = #{inspectQty}</if>
            <if test="frozenQty != null "> and frozen_qty = #{frozenQty}</if>
            <if test="costPrice != null "> and cost_price = #{costPrice}</if>
        </where>
    </select>

    <select id="selectErpInventoryByInventoryId" parameterType="Long" resultMap="ErpInventoryResult">
        <include refid="selectErpInventoryVo"/>
        where inventory_id = #{inventoryId}
    </select>

    <insert id="insertErpInventory" parameterType="ErpInventory" useGeneratedKeys="true" keyProperty="inventoryId">
        insert into erp_inventory
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="materialId != null">material_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="stockQty != null">stock_qty,</if>
            <if test="availableQty != null">available_qty,</if>
            <if test="reservedQty != null">reserved_qty,</if>
            <if test="inspectQty != null">inspect_qty,</if>
            <if test="frozenQty != null">frozen_qty,</if>
            <if test="costPrice != null">cost_price,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="materialId != null">#{materialId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="stockQty != null">#{stockQty},</if>
            <if test="availableQty != null">#{availableQty},</if>
            <if test="reservedQty != null">#{reservedQty},</if>
            <if test="inspectQty != null">#{inspectQty},</if>
            <if test="frozenQty != null">#{frozenQty},</if>
            <if test="costPrice != null">#{costPrice},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateErpInventory" parameterType="ErpInventory">
        update erp_inventory
        <trim prefix="SET" suffixOverrides=",">
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="stockQty != null">stock_qty = #{stockQty},</if>
            <if test="availableQty != null">available_qty = #{availableQty},</if>
            <if test="reservedQty != null">reserved_qty = #{reservedQty},</if>
            <if test="inspectQty != null">inspect_qty = #{inspectQty},</if>
            <if test="frozenQty != null">frozen_qty = #{frozenQty},</if>
            <if test="costPrice != null">cost_price = #{costPrice},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where inventory_id = #{inventoryId}
    </update>

    <delete id="deleteErpInventoryByInventoryId" parameterType="Long">
        delete from erp_inventory where inventory_id = #{inventoryId}
    </delete>

    <delete id="deleteErpInventoryByInventoryIds" parameterType="String">
        delete from erp_inventory where inventory_id in
        <foreach item="inventoryId" collection="array" open="(" separator="," close=")">
            #{inventoryId}
        </foreach>
    </delete>
</mapper>
