<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.inventory.mapper.ErpWarehouseMapper">

    <resultMap type="ErpWarehouse" id="ErpWarehouseResult">
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="warehouseCode"    column="warehouse_code"    />
        <result property="warehouseName"    column="warehouse_name"    />
        <result property="warehouseType"    column="warehouse_type"    />
        <result property="deptId"    column="dept_id"    />
        <result property="address"    column="address"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpWarehouseVo">
        select warehouse_id, warehouse_code, warehouse_name, warehouse_type, dept_id, address, status, create_by, create_time, update_by, update_time, remark from erp_warehouse
    </sql>

    <select id="selectErpWarehouseList" parameterType="ErpWarehouse" resultMap="ErpWarehouseResult">
        <include refid="selectErpWarehouseVo"/>
        <where>
            del_flag = '0'
            <if test="warehouseCode != null  and warehouseCode != ''"> and warehouse_code like concat('%', #{warehouseCode}, '%')</if>
            <if test="warehouseName != null  and warehouseName != ''"> and warehouse_name like concat('%', #{warehouseName}, '%')</if>
            <if test="warehouseType != null  and warehouseType != ''"> and warehouse_type = #{warehouseType}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpWarehouseByWarehouseId" parameterType="Long" resultMap="ErpWarehouseResult">
        <include refid="selectErpWarehouseVo"/>
        where warehouse_id = #{warehouseId}
    </select>

    <insert id="insertErpWarehouse" parameterType="ErpWarehouse" useGeneratedKeys="true" keyProperty="warehouseId">
        insert into erp_warehouse
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="warehouseCode != null and warehouseCode != ''">warehouse_code,</if>
            <if test="warehouseName != null and warehouseName != ''">warehouse_name,</if>
            <if test="warehouseType != null">warehouse_type,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="address != null">address,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="warehouseCode != null and warehouseCode != ''">#{warehouseCode},</if>
            <if test="warehouseName != null and warehouseName != ''">#{warehouseName},</if>
            <if test="warehouseType != null">#{warehouseType},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="address != null">#{address},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpWarehouse" parameterType="ErpWarehouse">
        update erp_warehouse
        <trim prefix="SET" suffixOverrides=",">
            <if test="warehouseCode != null and warehouseCode != ''">warehouse_code = #{warehouseCode},</if>
            <if test="warehouseName != null and warehouseName != ''">warehouse_name = #{warehouseName},</if>
            <if test="warehouseType != null">warehouse_type = #{warehouseType},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="address != null">address = #{address},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where warehouse_id = #{warehouseId}
    </update>

    <delete id="deleteErpWarehouseByWarehouseId" parameterType="Long">
        update erp_warehouse set del_flag = '2' where warehouse_id = #{warehouseId}
    </delete>

    <delete id="deleteErpWarehouseByWarehouseIds" parameterType="String">
        update erp_warehouse set del_flag = '2' where warehouse_id in
        <foreach item="warehouseId" collection="array" open="(" separator="," close=")">
            #{warehouseId}
        </foreach>
    </delete>
</mapper>
