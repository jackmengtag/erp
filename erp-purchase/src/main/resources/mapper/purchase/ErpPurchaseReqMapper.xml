<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.purchase.mapper.ErpPurchaseReqMapper">

    <resultMap type="ErpPurchaseReq" id="ErpPurchaseReqResult">
        <result property="reqId"    column="req_id"    />
        <result property="reqCode"    column="req_code"    />
        <result property="reqDate"    column="req_date"    />
        <result property="reqType"    column="req_type"    />
        <result property="deptId"    column="dept_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpPurchaseReqErpPurchaseReqLineResult" type="ErpPurchaseReq" extends="ErpPurchaseReqResult">
        <collection property="erpPurchaseReqLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpPurchaseReqLineResult" />
    </resultMap>

    <resultMap type="ErpPurchaseReqLine" id="ErpPurchaseReqLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="reqId"    column="sub_req_id"    />
        <result property="lineNo"    column="sub_line_no"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="qty"    column="sub_qty"    />
        <result property="needDate"    column="sub_need_date"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpPurchaseReqVo">
        select req_id, req_code, req_date, req_type, dept_id, status, create_by, create_time, update_by, update_time, remark from erp_purchase_req
    </sql>

    <select id="selectErpPurchaseReqList" parameterType="ErpPurchaseReq" resultMap="ErpPurchaseReqResult">
        <include refid="selectErpPurchaseReqVo"/>
        <where>
            del_flag = '0'
            <if test="reqCode != null  and reqCode != ''"> and req_code like concat('%', #{reqCode}, '%')</if>
            <if test="reqDate != null "> and req_date = #{reqDate}</if>
            <if test="reqType != null  and reqType != ''"> and req_type = #{reqType}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpPurchaseReqByReqId" parameterType="Long" resultMap="ErpPurchaseReqErpPurchaseReqLineResult">
        select a.req_id, a.req_code, a.req_date, a.req_type, a.dept_id, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.req_id as sub_req_id, b.line_no as sub_line_no, b.material_id as sub_material_id, b.qty as sub_qty, b.need_date as sub_need_date, b.create_time as sub_create_time
        from erp_purchase_req a
        left join erp_purchase_req_line b on b.req_id = a.req_id
        where a.req_id = #{reqId}
    </select>

    <insert id="insertErpPurchaseReq" parameterType="ErpPurchaseReq" useGeneratedKeys="true" keyProperty="reqId">
        insert into erp_purchase_req
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reqCode != null and reqCode != ''">req_code,</if>
            <if test="reqDate != null">req_date,</if>
            <if test="reqType != null">req_type,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reqCode != null and reqCode != ''">#{reqCode},</if>
            <if test="reqDate != null">#{reqDate},</if>
            <if test="reqType != null">#{reqType},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpPurchaseReq" parameterType="ErpPurchaseReq">
        update erp_purchase_req
        <trim prefix="SET" suffixOverrides=",">
            <if test="reqCode != null and reqCode != ''">req_code = #{reqCode},</if>
            <if test="reqDate != null">req_date = #{reqDate},</if>
            <if test="reqType != null">req_type = #{reqType},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where req_id = #{reqId}
    </update>

    <delete id="deleteErpPurchaseReqByReqId" parameterType="Long">
        update erp_purchase_req set del_flag = '2' where req_id = #{reqId}
    </delete>

    <delete id="deleteErpPurchaseReqByReqIds" parameterType="String">
        update erp_purchase_req set del_flag = '2' where req_id in
        <foreach item="reqId" collection="array" open="(" separator="," close=")">
            #{reqId}
        </foreach>
    </delete>

    <delete id="deleteErpPurchaseReqLineByReqId" parameterType="Long">
        delete from erp_purchase_req_line where req_id = #{reqId}
    </delete>

    <delete id="deleteErpPurchaseReqLineByReqIds" parameterType="String">
        delete from erp_purchase_req_line where req_id in
        <foreach item="reqId" collection="array" open="(" separator="," close=")">
            #{reqId}
        </foreach>
    </delete>

    <insert id="batchErpPurchaseReqLine">
        insert into erp_purchase_req_line( line_id, req_id, line_no, material_id, qty, need_date, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.reqId}, #{item.lineNo}, #{item.materialId}, #{item.qty}, #{item.needDate}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
