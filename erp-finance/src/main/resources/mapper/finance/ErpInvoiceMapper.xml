<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpInvoiceMapper">

    <resultMap type="ErpInvoice" id="ErpInvoiceResult">
        <result property="invoiceId"    column="invoice_id"    />
        <result property="invoiceCode"    column="invoice_code"    />
        <result property="invoiceNo"    column="invoice_no"    />
        <result property="invoiceType"    column="invoice_type"    />
        <result property="partnerId"    column="partner_id"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="invoiceDate"    column="invoice_date"    />
        <result property="amount"    column="amount"    />
        <result property="taxAmount"    column="tax_amount"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpInvoiceVo">
        select invoice_id, invoice_code, invoice_no, invoice_type, partner_id, source_type, source_id, invoice_date, amount, tax_amount, status, create_by, create_time, update_by, update_time, remark from erp_invoice
    </sql>

    <select id="selectErpInvoiceList" parameterType="ErpInvoice" resultMap="ErpInvoiceResult">
        <include refid="selectErpInvoiceVo"/>
        <where>
            del_flag = '0'
            <if test="invoiceCode != null  and invoiceCode != ''"> and invoice_code like concat('%', #{invoiceCode}, '%')</if>
            <if test="invoiceNo != null  and invoiceNo != ''"> and invoice_no like concat('%', #{invoiceNo}, '%')</if>
            <if test="invoiceType != null  and invoiceType != ''"> and invoice_type = #{invoiceType}</if>
            <if test="partnerId != null "> and partner_id = #{partnerId}</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="invoiceDate != null "> and invoice_date = #{invoiceDate}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="taxAmount != null "> and tax_amount = #{taxAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpInvoiceByInvoiceId" parameterType="Long" resultMap="ErpInvoiceResult">
        <include refid="selectErpInvoiceVo"/>
        where invoice_id = #{invoiceId}
    </select>

    <insert id="insertErpInvoice" parameterType="ErpInvoice" useGeneratedKeys="true" keyProperty="invoiceId">
        insert into erp_invoice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="invoiceCode != null and invoiceCode != ''">invoice_code,</if>
            <if test="invoiceNo != null">invoice_no,</if>
            <if test="invoiceType != null">invoice_type,</if>
            <if test="partnerId != null">partner_id,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="amount != null">amount,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="invoiceCode != null and invoiceCode != ''">#{invoiceCode},</if>
            <if test="invoiceNo != null">#{invoiceNo},</if>
            <if test="invoiceType != null">#{invoiceType},</if>
            <if test="partnerId != null">#{partnerId},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="amount != null">#{amount},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpInvoice" parameterType="ErpInvoice">
        update erp_invoice
        <trim prefix="SET" suffixOverrides=",">
            <if test="invoiceCode != null and invoiceCode != ''">invoice_code = #{invoiceCode},</if>
            <if test="invoiceNo != null">invoice_no = #{invoiceNo},</if>
            <if test="invoiceType != null">invoice_type = #{invoiceType},</if>
            <if test="partnerId != null">partner_id = #{partnerId},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where invoice_id = #{invoiceId}
    </update>

    <delete id="deleteErpInvoiceByInvoiceId" parameterType="Long">
        update erp_invoice set del_flag = '2' where invoice_id = #{invoiceId}
    </delete>

    <delete id="deleteErpInvoiceByInvoiceIds" parameterType="String">
        update erp_invoice set del_flag = '2' where invoice_id in
        <foreach item="invoiceId" collection="array" open="(" separator="," close=")">
            #{invoiceId}
        </foreach>
    </delete>
</mapper>
