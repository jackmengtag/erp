            <if test="materialId != null">material_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="direction != null and direction != ''">direction,</if>
            <if test="qty != null">qty,</if>
            <if test="costPrice != null">cost_price,</if>
            <if test="amount != null">amount,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="sourceCode != null">source_code,</if>
            <if test="operBy != null">oper_by,</if>
            <if test="txnTime != null">txn_time,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="txnType != null and txnType != ''">#{txnType},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="direction != null and direction != ''">#{direction},</if>
            <if test="qty != null">#{qty},</if>
            <if test="costPrice != null">#{costPrice},</if>
            <if test="amount != null">#{amount},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="sourceCode != null">#{sourceCode},</if>
            <if test="operBy != null">#{operBy},</if>
            <if test="txnTime != null">#{txnTime},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateErpInventoryTxn" parameterType="ErpInventoryTxn">
        update erp_inventory_txn
        <trim prefix="SET" suffixOverrides=",">
            <if test="txnType != null and txnType != ''">txn_type = #{txnType},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="direction != null and direction != ''">direction = #{direction},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="costPrice != null">cost_price = #{costPrice},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="sourceCode != null">source_code = #{sourceCode},</if>
            <if test="operBy != null">oper_by = #{operBy},</if>
            <if test="txnTime != null">txn_time = #{txnTime},</if>
        </trim>
