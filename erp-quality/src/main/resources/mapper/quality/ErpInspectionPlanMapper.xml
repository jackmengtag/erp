<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.quality.mapper.ErpInspectionPlanMapper">

    <resultMap type="ErpInspectionPlan" id="ErpInspectionPlanResult">
        <result property="planId"    column="plan_id"    />
        <result property="planCode"    column="plan_code"    />
        <result property="planName"    column="plan_name"    />
        <result property="inspectType"    column="inspect_type"    />
        <result property="materialId"    column="material_id"    />
        <result property="sampleRule"    column="sample_rule"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpInspectionPlanErpInspectionPlanLineResult" type="ErpInspectionPlan" extends="ErpInspectionPlanResult">
        <collection property="erpInspectionPlanLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpInspectionPlanLineResult" />
    </resultMap>

    <resultMap type="ErpInspectionPlanLine" id="ErpInspectionPlanLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="planId"    column="sub_plan_id"    />
        <result property="itemName"    column="sub_item_name"    />
        <result property="standardValue"    column="sub_standard_value"    />
        <result property="judgeRule"    column="sub_judge_rule"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpInspectionPlanVo">
        select plan_id, plan_code, plan_name, inspect_type, material_id, sample_rule, status, create_by, create_time, update_by, update_time, remark from erp_inspection_plan
    </sql>

    <select id="selectErpInspectionPlanList" parameterType="ErpInspectionPlan" resultMap="ErpInspectionPlanResult">
        <include refid="selectErpInspectionPlanVo"/>
        <where>
            del_flag = '0'
            <if test="planCode != null  and planCode != ''"> and plan_code like concat('%', #{planCode}, '%')</if>
            <if test="planName != null  and planName != ''"> and plan_name like concat('%', #{planName}, '%')</if>
            <if test="inspectType != null  and inspectType != ''"> and inspect_type = #{inspectType}</if>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="sampleRule != null  and sampleRule != ''"> and sample_rule = #{sampleRule}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpInspectionPlanByPlanId" parameterType="Long" resultMap="ErpInspectionPlanErpInspectionPlanLineResult">
        select a.plan_id, a.plan_code, a.plan_name, a.inspect_type, a.material_id, a.sample_rule, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.plan_id as sub_plan_id, b.item_name as sub_item_name, b.standard_value as sub_standard_value, b.judge_rule as sub_judge_rule, b.create_time as sub_create_time
        from erp_inspection_plan a
        left join erp_inspection_plan_line b on b.plan_id = a.plan_id
        where a.plan_id = #{planId}
    </select>

    <insert id="insertErpInspectionPlan" parameterType="ErpInspectionPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into erp_inspection_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planCode != null and planCode != ''">plan_code,</if>
            <if test="planName != null and planName != ''">plan_name,</if>
            <if test="inspectType != null">inspect_type,</if>
            <if test="materialId != null">material_id,</if>
            <if test="sampleRule != null">sample_rule,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planCode != null and planCode != ''">#{planCode},</if>
            <if test="planName != null and planName != ''">#{planName},</if>
            <if test="inspectType != null">#{inspectType},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="sampleRule != null">#{sampleRule},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpInspectionPlan" parameterType="ErpInspectionPlan">
        update erp_inspection_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planCode != null and planCode != ''">plan_code = #{planCode},</if>
            <if test="planName != null and planName != ''">plan_name = #{planName},</if>
            <if test="inspectType != null">inspect_type = #{inspectType},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="sampleRule != null">sample_rule = #{sampleRule},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where plan_id = #{planId}
    </update>

    <delete id="deleteErpInspectionPlanByPlanId" parameterType="Long">
        update erp_inspection_plan set del_flag = '2' where plan_id = #{planId}
    </delete>

    <delete id="deleteErpInspectionPlanByPlanIds" parameterType="String">
        update erp_inspection_plan set del_flag = '2' where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>

    <delete id="deleteErpInspectionPlanLineByPlanId" parameterType="Long">
        delete from erp_inspection_plan_line where plan_id = #{planId}
    </delete>

    <delete id="deleteErpInspectionPlanLineByPlanIds" parameterType="String">
        delete from erp_inspection_plan_line where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>

    <insert id="batchErpInspectionPlanLine">
        insert into erp_inspection_plan_line( line_id, plan_id, item_name, standard_value, judge_rule, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.planId}, #{item.itemName}, #{item.standardValue}, #{item.judgeRule}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
