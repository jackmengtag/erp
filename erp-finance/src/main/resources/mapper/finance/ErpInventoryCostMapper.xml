<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpInventoryCostMapper">

    <resultMap type="ErpInventoryCost" id="ErpInventoryCostResult">
        <result property="costId"    column="cost_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="periods"    column="periods"    />
        <result property="beginQty"    column="begin_qty"    />
        <result property="beginAmount"    column="begin_amount"    />
        <result property="inQty"    column="in_qty"    />
        <result property="inAmount"    column="in_amount"    />
        <result property="outQty"    column="out_qty"    />
        <result property="outAmount"    column="out_amount"    />
        <result property="endQty"    column="end_qty"    />
        <result property="endAmount"    column="end_amount"    />
        <result property="unitCost"    column="unit_cost"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectErpInventoryCostVo">
        select cost_id, material_id, warehouse_id, periods, begin_qty, begin_amount, in_qty, in_amount, out_qty, out_amount, end_qty, end_amount, unit_cost, create_time from erp_inventory_cost
    </sql>

    <select id="selectErpInventoryCostList" parameterType="ErpInventoryCost" resultMap="ErpInventoryCostResult">
        <include refid="selectErpInventoryCostVo"/>
        <where>
            <if test="materialId != null "> and material_id = #{materialId}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="periods != null  and periods != ''"> and periods = #{periods}</if>
            <if test="beginQty != null "> and begin_qty = #{beginQty}</if>
            <if test="beginAmount != null "> and begin_amount = #{beginAmount}</if>
            <if test="inQty != null "> and in_qty = #{inQty}</if>
            <if test="inAmount != null "> and in_amount = #{inAmount}</if>
            <if test="outQty != null "> and out_qty = #{outQty}</if>
            <if test="outAmount != null "> and out_amount = #{outAmount}</if>
            <if test="endQty != null "> and end_qty = #{endQty}</if>
            <if test="endAmount != null "> and end_amount = #{endAmount}</if>
            <if test="unitCost != null "> and unit_cost = #{unitCost}</if>
        </where>
    </select>

    <select id="selectErpInventoryCostByCostId" parameterType="Long" resultMap="ErpInventoryCostResult">
        <include refid="selectErpInventoryCostVo"/>
        where cost_id = #{costId}
    </select>

    <insert id="insertErpInventoryCost" parameterType="ErpInventoryCost" useGeneratedKeys="true" keyProperty="costId">
        insert into erp_inventory_cost
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="materialId != null">material_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="periods != null">periods,</if>
            <if test="beginQty != null">begin_qty,</if>
            <if test="beginAmount != null">begin_amount,</if>
            <if test="inQty != null">in_qty,</if>
            <if test="inAmount != null">in_amount,</if>
            <if test="outQty != null">out_qty,</if>
            <if test="outAmount != null">out_amount,</if>
            <if test="endQty != null">end_qty,</if>
            <if test="endAmount != null">end_amount,</if>
            <if test="unitCost != null">unit_cost,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="materialId != null">#{materialId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="periods != null">#{periods},</if>
            <if test="beginQty != null">#{beginQty},</if>
            <if test="beginAmount != null">#{beginAmount},</if>
            <if test="inQty != null">#{inQty},</if>
            <if test="inAmount != null">#{inAmount},</if>
            <if test="outQty != null">#{outQty},</if>
            <if test="outAmount != null">#{outAmount},</if>
            <if test="endQty != null">#{endQty},</if>
            <if test="endAmount != null">#{endAmount},</if>
            <if test="unitCost != null">#{unitCost},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateErpInventoryCost" parameterType="ErpInventoryCost">
        update erp_inventory_cost
        <trim prefix="SET" suffixOverrides=",">
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="periods != null">periods = #{periods},</if>
            <if test="beginQty != null">begin_qty = #{beginQty},</if>
            <if test="beginAmount != null">begin_amount = #{beginAmount},</if>
            <if test="inQty != null">in_qty = #{inQty},</if>
            <if test="inAmount != null">in_amount = #{inAmount},</if>
            <if test="outQty != null">out_qty = #{outQty},</if>
            <if test="outAmount != null">out_amount = #{outAmount},</if>
            <if test="endQty != null">end_qty = #{endQty},</if>
            <if test="endAmount != null">end_amount = #{endAmount},</if>
            <if test="unitCost != null">unit_cost = #{unitCost},</if>
        </trim>
        where cost_id = #{costId}
    </update>

    <delete id="deleteErpInventoryCostByCostId" parameterType="Long">
        delete from erp_inventory_cost where cost_id = #{costId}
    </delete>

    <delete id="deleteErpInventoryCostByCostIds" parameterType="String">
        delete from erp_inventory_cost where cost_id in
        <foreach item="costId" collection="array" open="(" separator="," close=")">
            #{costId}
        </foreach>
    </delete>
</mapper>
