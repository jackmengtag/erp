<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.plan.mapper.ErpDemandForecastMapper">

    <resultMap type="ErpDemandForecast" id="ErpDemandForecastResult">
        <result property="forecastId"    column="forecast_id"    />
        <result property="forecastCode"    column="forecast_code"    />
        <result property="forecastName"    column="forecast_name"    />
        <result property="forecastVersion"    column="forecast_version"    />
        <result property="periodStart"    column="period_start"    />
        <result property="periodEnd"    column="period_end"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ErpDemandForecastErpDemandForecastLineResult" type="ErpDemandForecast" extends="ErpDemandForecastResult">
        <collection property="erpDemandForecastLineList" notNullColumn="sub_line_id" javaType="java.util.List" resultMap="ErpDemandForecastLineResult" />
    </resultMap>

    <resultMap type="ErpDemandForecastLine" id="ErpDemandForecastLineResult">
        <result property="lineId"    column="sub_line_id"    />
        <result property="forecastId"    column="sub_forecast_id"    />
        <result property="materialId"    column="sub_material_id"    />
        <result property="periodMonth"    column="sub_period_month"    />
        <result property="forecastQty"    column="sub_forecast_qty"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectErpDemandForecastVo">
        select forecast_id, forecast_code, forecast_name, forecast_version, period_start, period_end, status, create_by, create_time, update_by, update_time, remark from erp_demand_forecast
    </sql>

    <select id="selectErpDemandForecastList" parameterType="ErpDemandForecast" resultMap="ErpDemandForecastResult">
        <include refid="selectErpDemandForecastVo"/>
        <where>
            del_flag = '0'
            <if test="forecastCode != null  and forecastCode != ''"> and forecast_code like concat('%', #{forecastCode}, '%')</if>
            <if test="forecastName != null  and forecastName != ''"> and forecast_name like concat('%', #{forecastName}, '%')</if>
            <if test="forecastVersion != null  and forecastVersion != ''"> and forecast_version = #{forecastVersion}</if>
            <if test="periodStart != null "> and period_start = #{periodStart}</if>
            <if test="periodEnd != null "> and period_end = #{periodEnd}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpDemandForecastByForecastId" parameterType="Long" resultMap="ErpDemandForecastErpDemandForecastLineResult">
        select a.forecast_id, a.forecast_code, a.forecast_name, a.forecast_version, a.period_start, a.period_end, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               b.line_id as sub_line_id, b.forecast_id as sub_forecast_id, b.material_id as sub_material_id, b.period_month as sub_period_month, b.forecast_qty as sub_forecast_qty, b.create_time as sub_create_time
        from erp_demand_forecast a
        left join erp_demand_forecast_line b on b.forecast_id = a.forecast_id
        where a.forecast_id = #{forecastId}
    </select>

    <insert id="insertErpDemandForecast" parameterType="ErpDemandForecast" useGeneratedKeys="true" keyProperty="forecastId">
        insert into erp_demand_forecast
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="forecastCode != null and forecastCode != ''">forecast_code,</if>
            <if test="forecastName != null">forecast_name,</if>
            <if test="forecastVersion != null">forecast_version,</if>
            <if test="periodStart != null">period_start,</if>
            <if test="periodEnd != null">period_end,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="forecastCode != null and forecastCode != ''">#{forecastCode},</if>
            <if test="forecastName != null">#{forecastName},</if>
            <if test="forecastVersion != null">#{forecastVersion},</if>
            <if test="periodStart != null">#{periodStart},</if>
            <if test="periodEnd != null">#{periodEnd},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpDemandForecast" parameterType="ErpDemandForecast">
        update erp_demand_forecast
        <trim prefix="SET" suffixOverrides=",">
            <if test="forecastCode != null and forecastCode != ''">forecast_code = #{forecastCode},</if>
            <if test="forecastName != null">forecast_name = #{forecastName},</if>
            <if test="forecastVersion != null">forecast_version = #{forecastVersion},</if>
            <if test="periodStart != null">period_start = #{periodStart},</if>
            <if test="periodEnd != null">period_end = #{periodEnd},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where forecast_id = #{forecastId}
    </update>

    <delete id="deleteErpDemandForecastByForecastId" parameterType="Long">
        update erp_demand_forecast set del_flag = '2' where forecast_id = #{forecastId}
    </delete>

    <delete id="deleteErpDemandForecastByForecastIds" parameterType="String">
        update erp_demand_forecast set del_flag = '2' where forecast_id in
        <foreach item="forecastId" collection="array" open="(" separator="," close=")">
            #{forecastId}
        </foreach>
    </delete>

    <delete id="deleteErpDemandForecastLineByForecastId" parameterType="Long">
        delete from erp_demand_forecast_line where forecast_id = #{forecastId}
    </delete>

    <delete id="deleteErpDemandForecastLineByForecastIds" parameterType="String">
        delete from erp_demand_forecast_line where forecast_id in
        <foreach item="forecastId" collection="array" open="(" separator="," close=")">
            #{forecastId}
        </foreach>
    </delete>

    <insert id="batchErpDemandForecastLine">
        insert into erp_demand_forecast_line( line_id, forecast_id, material_id, period_month, forecast_qty, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.lineId}, #{item.forecastId}, #{item.materialId}, #{item.periodMonth}, #{item.forecastQty}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
