<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpVoucherMapper">

    <resultMap type="ErpVoucher" id="ErpVoucherResult">
        <result property="voucherId"    column="voucher_id"    />
        <result property="voucherCode"    column="voucher_code"    />
        <result property="bizType"    column="biz_type"    />
        <result property="bizId"    column="biz_id"    />
        <result property="eventType"    column="event_type"    />
        <result property="amount"    column="amount"    />
        <result property="periods"    column="periods"    />
        <result property="sourceDoc"    column="source_doc"    />
        <result property="genStatus"    column="gen_status"    />
        <result property="retryTimes"    column="retry_times"    />
        <result property="errorMsg"    column="error_msg"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpVoucherVo">
        select voucher_id, voucher_code, biz_type, biz_id, event_type, amount, periods, source_doc, gen_status, retry_times, error_msg, create_by, create_time, update_by, update_time, remark from erp_voucher
    </sql>

    <select id="selectErpVoucherList" parameterType="ErpVoucher" resultMap="ErpVoucherResult">
        <include refid="selectErpVoucherVo"/>
        <where>
            <if test="voucherCode != null  and voucherCode != ''"> and voucher_code like concat('%', #{voucherCode}, '%')</if>
            <if test="bizType != null  and bizType != ''"> and biz_type = #{bizType}</if>
            <if test="bizId != null "> and biz_id = #{bizId}</if>
            <if test="eventType != null  and eventType != ''"> and event_type = #{eventType}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="periods != null  and periods != ''"> and periods = #{periods}</if>
            <if test="sourceDoc != null  and sourceDoc != ''"> and source_doc = #{sourceDoc}</if>
            <if test="genStatus != null  and genStatus != ''"> and gen_status = #{genStatus}</if>
            <if test="retryTimes != null "> and retry_times = #{retryTimes}</if>
            <if test="errorMsg != null  and errorMsg != ''"> and error_msg = #{errorMsg}</if>
        </where>
    </select>

    <select id="selectErpVoucherByVoucherId" parameterType="Long" resultMap="ErpVoucherResult">
        <include refid="selectErpVoucherVo"/>
        where voucher_id = #{voucherId}
    </select>

    <insert id="insertErpVoucher" parameterType="ErpVoucher" useGeneratedKeys="true" keyProperty="voucherId">
        insert into erp_voucher
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="voucherCode != null and voucherCode != ''">voucher_code,</if>
            <if test="bizType != null">biz_type,</if>
            <if test="bizId != null">biz_id,</if>
            <if test="eventType != null">event_type,</if>
            <if test="amount != null">amount,</if>
            <if test="periods != null">periods,</if>
            <if test="sourceDoc != null">source_doc,</if>
            <if test="genStatus != null">gen_status,</if>
            <if test="retryTimes != null">retry_times,</if>
            <if test="errorMsg != null">error_msg,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="voucherCode != null and voucherCode != ''">#{voucherCode},</if>
            <if test="bizType != null">#{bizType},</if>
            <if test="bizId != null">#{bizId},</if>
            <if test="eventType != null">#{eventType},</if>
            <if test="amount != null">#{amount},</if>
            <if test="periods != null">#{periods},</if>
            <if test="sourceDoc != null">#{sourceDoc},</if>
            <if test="genStatus != null">#{genStatus},</if>
            <if test="retryTimes != null">#{retryTimes},</if>
            <if test="errorMsg != null">#{errorMsg},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpVoucher" parameterType="ErpVoucher">
        update erp_voucher
        <trim prefix="SET" suffixOverrides=",">
            <if test="voucherCode != null and voucherCode != ''">voucher_code = #{voucherCode},</if>
            <if test="bizType != null">biz_type = #{bizType},</if>
            <if test="bizId != null">biz_id = #{bizId},</if>
            <if test="eventType != null">event_type = #{eventType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="periods != null">periods = #{periods},</if>
            <if test="sourceDoc != null">source_doc = #{sourceDoc},</if>
            <if test="genStatus != null">gen_status = #{genStatus},</if>
            <if test="retryTimes != null">retry_times = #{retryTimes},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where voucher_id = #{voucherId}
    </update>

    <delete id="deleteErpVoucherByVoucherId" parameterType="Long">
        delete from erp_voucher where voucher_id = #{voucherId}
    </delete>

    <delete id="deleteErpVoucherByVoucherIds" parameterType="String">
        delete from erp_voucher where voucher_id in
        <foreach item="voucherId" collection="array" open="(" separator="," close=")">
            #{voucherId}
        </foreach>
    </delete>
</mapper>
