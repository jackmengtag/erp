<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.finance.mapper.ErpReceivableMapper">

    <resultMap type="ErpReceivable" id="ErpReceivableResult">
        <result property="arId"    column="ar_id"    />
        <result property="arCode"    column="ar_code"    />
        <result property="customerId"    column="customer_id"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="bizDate"    column="biz_date"    />
        <result property="dueDate"    column="due_date"    />
        <result property="amount"    column="amount"    />
        <result property="settledAmount"    column="settled_amount"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectErpReceivableVo">
        select ar_id, ar_code, customer_id, source_type, source_id, biz_date, due_date, amount, settled_amount, status, create_by, create_time, update_by, update_time, remark from erp_receivable
    </sql>

    <select id="selectErpReceivableList" parameterType="ErpReceivable" resultMap="ErpReceivableResult">
        <include refid="selectErpReceivableVo"/>
        <where>
            del_flag = '0'
            <if test="arCode != null  and arCode != ''"> and ar_code like concat('%', #{arCode}, '%')</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="bizDate != null "> and biz_date = #{bizDate}</if>
            <if test="dueDate != null "> and due_date = #{dueDate}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="settledAmount != null "> and settled_amount = #{settledAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectErpReceivableByArId" parameterType="Long" resultMap="ErpReceivableResult">
        <include refid="selectErpReceivableVo"/>
        where ar_id = #{arId}
    </select>

    <insert id="insertErpReceivable" parameterType="ErpReceivable" useGeneratedKeys="true" keyProperty="arId">
        insert into erp_receivable
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="arCode != null and arCode != ''">ar_code,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="bizDate != null">biz_date,</if>
            <if test="dueDate != null">due_date,</if>
            <if test="amount != null">amount,</if>
            <if test="settledAmount != null">settled_amount,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="arCode != null and arCode != ''">#{arCode},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="bizDate != null">#{bizDate},</if>
            <if test="dueDate != null">#{dueDate},</if>
            <if test="amount != null">#{amount},</if>
            <if test="settledAmount != null">#{settledAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateErpReceivable" parameterType="ErpReceivable">
        update erp_receivable
        <trim prefix="SET" suffixOverrides=",">
            <if test="arCode != null and arCode != ''">ar_code = #{arCode},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="bizDate != null">biz_date = #{bizDate},</if>
            <if test="dueDate != null">due_date = #{dueDate},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="settledAmount != null">settled_amount = #{settledAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where ar_id = #{arId}
    </update>

    <delete id="deleteErpReceivableByArId" parameterType="Long">
        update erp_receivable set del_flag = '2' where ar_id = #{arId}
    </delete>

    <delete id="deleteErpReceivableByArIds" parameterType="String">
        update erp_receivable set del_flag = '2' where ar_id in
        <foreach item="arId" collection="array" open="(" separator="," close=")">
            #{arId}
        </foreach>
    </delete>
</mapper>
